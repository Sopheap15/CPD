# Get a token from @BotFather on Telegram, then copy this file to .env
TELEGRAM_BOT_TOKEN=123456789:AAE-YourBotFatherTokenHere

# Optional: read data live from Google Sheets (no download, no API key).
# Share each sheet with "Anyone with the link -> Viewer".
# GS_ID_R is the registration-form responses spreadsheet.
# GS_ID_C is only needed if the certificate-pickup form has
# its own separate spreadsheet.
GS_ID_R=
GS_ID_C=