TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# Optional: route Telegram traffic through a Cloudflare Worker proxy.
# TELEGRAM_API_BASE_URL=https://your-worker.workers.dev/bot

# Comma-separated Telegram User IDs allowed to run admin commands.
# To get your ID, message the bot with /myid or @userinfobot.
ADMIN_IDS=123456789

# --- ABA Payment Receipt Verification ---
# The bot verifies receipts uploaded by students using local OCR (Tesseract).
# It checks that the receipt contains the correct recipient and the correct amount.

# Primary check: recipient name as printed on KHQR receipts (under "To Account").
ABA_MERCHANT_NAME=SOPHEAP OENG

# Fallback check: ABA account number (visible on direct bank-transfer receipts).
ABA_ACCOUNT_NUMBER=002370133
